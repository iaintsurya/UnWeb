FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /opt/unweb

COPY backend/requirements.txt backend/requirements-browser.txt ./
RUN python -m pip install --no-cache-dir -r requirements-browser.txt \
    && python -m playwright install --with-deps chromium

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin unweb \
    && chown -R unweb:unweb /ms-playwright /opt/unweb

COPY --chown=unweb:unweb backend/app ./app

USER 10001:10001

ENTRYPOINT ["python", "-m", "app.browser_worker"]
