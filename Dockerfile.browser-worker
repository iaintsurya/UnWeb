FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /opt/unweb

COPY backend/requirements.txt ./requirements.txt
COPY backend/requirements-browser.txt ./requirements-browser.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends libatomic1 \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir -r requirements.txt -r requirements-browser.txt \
    && python -m playwright install --with-deps chromium

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin unweb \
    && mkdir -p /data \
    && chown -R unweb:unweb /ms-playwright /opt/unweb /data

COPY --chown=unweb:unweb backend/app ./app

USER 10001:10001

ENTRYPOINT ["python", "-m", "app.browser_worker"]
