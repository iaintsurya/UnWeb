# Copy to your deployment environment; never commit real secrets.
# Generate with: openssl rand -hex 32
UNWEB_AUTH_PROXY_SECRET=replace-with-a-unique-random-64-character-secret

# The ingress network must be shared with your trusted authentication gateway.
UNWEB_INGRESS_NETWORK=unweb-ingress

# The egress network must be protected by host/cloud firewall policy.
UNWEB_EGRESS_NETWORK=unweb-egress

# Exact browser origin(s), comma-separated. Leave empty for same-origin deployment.
UNWEB_CORS_ORIGINS=
